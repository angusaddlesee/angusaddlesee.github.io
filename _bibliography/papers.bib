  author={Addlesee, Angus and Damonte, Marco},
  booktitle={Proceedings of the 5th Conference on Conversational User Interfaces},
  year={2023},
  abstract={Proposes methods for interpreting incomplete or interrupted questions so assistants can respond without forcing restarts.}
}

