  author={Addlesee, Angus and Denley, Daniel and Edmondson, Andy and Gunson, Nancie and Garcia, Daniel Hern{\'a}ndez and Kha, Alexandre and Lemon, Oliver and Ndubuisi, James and O'Reilly, Neil and Perochaud, Lia and Valeri, Rapha{\"e}l and Worika, Miebaka},
  booktitle={Proceedings of the workshop on advancing GROup UNderstanding and robots aDaptive behaviour (GROUND)},
  year={2023},
  abstract={Benchmarks diarisation-led approaches for detecting agreement in multi-party dialogue against simpler procedural baselines.}
}

@inproceedings{schauer2023detecting,
  title={Detecting Agreement in Multi-party Conversational AI},
  author={Schauer, Laura and Sweeny, Jason and Lyttle, Charlie and Said, Zein and Szeles, Aron and Clark, Cale and McAskill, Katie and Wickham, Xander and Byars, Tom and Garcia, Daniel Hern{\'a}ndez and Gunson, Nancie and Addlesee, Angus and Lemon, Oliver},
