  abstract={Details a data collection pipeline for multi-party robot dialogues, capturing turn-taking and goal progress.}
}

@inproceedings{addlesee2022securely,
  title={Securely Capturing People's Interactions with Voice Assistants at Home: A Bespoke Tool for Ethical Data Collection},
  author={Addlesee, Angus},
  booktitle={Proceedings of the Second Workshop on NLP for Positive Impact (NLP4PI)},
  pages={25--30},
  year={2022},
  abstract={Speech patterns vary individually, yet current spoken dialogue systems rely on general patterns that do not serve all user groups well, particularly those with conditions like dementia who produce more disfluent speech. We present CVR-SI, a bespoke tool for ethical data collection designed initially for healthcare but applicable more broadly. We explain why commercial solutions fail to protect sensitive data adequately, then detail the security and ethical design of our device, including instructions for building both hardware and software components accessible to researchers without hardware expertise.}
}

@inproceedings{gunson2022visually,
  title={A Visually-Aware Conversational Robot Receptionist},
  author={Gunson, Nancie and Garcia, Daniel Hern{\'a}ndez and Siei{\'n}ska, Weronika and Addlesee, Angus and Dondrup, Christian and Lemon, Oliver and Part, Jose L and Yu, Yanchao},
  booktitle={Proceedings of the 23rd Annual Meeting of the Special Interest Group on Discourse and Dialogue},
  pages={645--648},
  year={2022},
  abstract={We present a robot receptionist system for hospital settings that demonstrates task-based and social dialogue via natural spoken conversation combined with visual awareness capabilities. The system can perceive and discuss the shared physical environment and assist users in locating objects. It includes practical features like check-in services, wayfinding, facility FAQs, social interactions, and the ability to answer questions grounded in visual context, deployed on a humanoid ARI robot for real-world use in a hospital reception area.}
}

