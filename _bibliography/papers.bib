  abstract={Presents student-led experiments on recognising agreement signals to keep group conversations flowing smoothly.}
}

@inproceedings{addlesee2023understandingamr,
  author={Angus Addlesee and Marco Damonte},
  title={Understanding Disrupted Sentences Using Underspecified Abstract Meaning Representation},
  year={2023},
  booktitle={Proceedings of INTERSPEECH 2023},
  pages={1224--1228},
  doi={10.21437/Interspeech.2023-307},
  abstract={We investigate whether semantic parsing can help voice assistants understand disrupted speech from groups like people with dementia or hearing impairments, as well as handle external noise disruptions. We created datasets pairing disrupted sentences with underspecified Abstract Meaning Representation (AMR) graphs. Our best disruption recovery pipeline lost only 1.6\% graph similarity f-score when compared to a model given the full original sentence, demonstrating that semantic parsing techniques can significantly improve spoken dialogue system robustness for both accessibility and noise-handling purposes.}
}

