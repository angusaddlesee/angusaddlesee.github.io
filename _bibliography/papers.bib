@inproceedings{alamedapineda2025socially,
  title={Socially Pertinent Robots in Gerontological Healthcare},
  author={Alameda-Pineda, Xavier and Addlesee, Angus and Hern{\'a}ndez Garc{\'i}a, Daniel and Reinke, Chris and Arias, Soraya and Arrigoni, Federica and Auternaud, Alex and Blavette, Lauriane and Beyan, Cigdem and Gomez Camara, Luis and Cohen, Ohad and Conti, Alessandro and Dacunha, S{\'e}bastien and Dondrup, Christian and Ellinson, Yoav and Ferro, Francesco and Gannot, Sharon and Gras, Florian and Gunson, Nancie and Horaud, Radu and D'Inc{\`a}, Moreno and Kimouche, Imad and Lemaignan, S{\'e}verin and Lemon, Oliver and Liotard, Cyril and Marchionni, Luca and Moradi, Mordehay and Pajdla, Tomas and Pino, Maribel and Polic, Michal and Py, Matthieu and Rado, Ariel and Ren, Bin and Ricci, Elisa and Rigaud, Anne-Sophie and Rota, Paolo and Romeo, Marta and Sebe, Nicu and Siei{\'n}ska, Weronika and Tandeitnik, Pinchas and Tonini, Francesco and Turro, Nicolas and Wintz, Timoth{\'e}e and Yu, Yanchao},
  booktitle={International Journal of Social Robotics},
  year={2025},
  selected={true},
  abstract={This paper examines whether autonomous social robots with conversational abilities can be practically useful in elderly care settings. We conducted two experimental phases at a Parisian day-care facility, testing a full-sized humanoid robot with roughly 60 end-users including patients and caregivers. We assessed acceptability using the Acceptability Evaluation Scale and usability via the System Usability Scale. Our findings reveal that users are receptive to this technology, especially when the robot's perception and action skills are robust to environmental challenges. We also document user concerns and suggestions for improvement in this previously underexplored gerontological healthcare environment.}
}

@inproceedings{addlesee2025building,
  title={Building for Speech: Designing the Next Generation of Social Robots for Audio Interaction},
  author={Addlesee, Angus and Papaioannou, Ioannis},
  booktitle={Frontiers in Robotics and AI},
  year={2025},
  abstract={Despite significant advances in robotics, conversational AI, and spoken dialogue systems, social robots remain largely absent from public spaces. We argue that early-stage collaboration between robot designers and spoken dialogue system researchers is crucial for creating social robots that can legitimately be used in real-world environments. We identify key challenges including insufficient audio output for noisy environments and hearing-impaired users, inadequate microphone arrays compared to commercial voice assistants, ego-noise from robot motors degrading speech recognition, and fragile joints posing safety risks to vulnerable populations. We recommend fitting multiple directional speakers, high-quality microphone arrays, quieter motors, and more robust joints so that researchers can create spoken dialogue systems that are more accessible and able to handle multi-party conversations in populated environments.}
}

@article{hernandezgarcia2025evaluating,
  title={Evaluating Multi-party Interactions with Social Robots Using Large Language Models and Multi-modal Systems},
  author={Hern{\'a}ndez Garc{\'i}a, Daniel and Gunson, Nancie and Addlesee, Angus and Siei{\'n}ska, Weronika and Dondrup, Christian and Lemon, Oliver},
  journal={International Journal of Interaction Studies},
  year={2025},
  abstract={Evaluates multi-party interaction quality with social robots using LLMs and multi-modal perception systems.}
}

@phdthesis{addlesee2024incremental,
  title={Incremental multi-party conversational AI for people with dementia},
  author={Addlesee, Angus},
  year={2024},
  school={Heriot-Watt University},
  selected={true},
  abstract={This thesis develops incremental multi-party conversational AI systems designed to support people with dementia. Current voice assistants assume turn-based interaction with a single user, but clinical settings involve multiple participants with varying cognitive abilities. We present systems that process speech incrementally, manage multi-party hospital conversations, and adapt to the speech production changes associated with dementia including extended pauses, interrupted utterances, and word-finding difficulties.}
}

@article{addlesee2024you,
  title={You Have Interrupted Me Again!: Making Voice Assistants More Dementia-Friendly With Incremental Clarification},
  author={Addlesee, Angus and Eshghi, Arash},
  journal={Frontiers in Dementia},
  year={2024},
  selected={true},
  abstract={Speakers seldom have a full plan of what they are going to say in advance and require incremental planning during speech, often resulting in pauses. This is particularly important for accessibility, as individuals with dementia experience longer and more frequent pauses, yet current voice assistants interrupt prematurely. We developed SLUICE-CR, a corpus containing 3,000 human-generated incremental clarification requests (iCRs), and tested large language models' ability to both generate and respond to these requests appropriately. Our findings show that larger LLMs interpret incremental clarificational exchanges more effectively, indicating these models can be configured to handle speech patterns typical of people with dementia and reduce user frustration.}
}

@inproceedings{addlesee2024multiparty,
  title={Multi-party Multimodal Conversations Between Patients, Their Companions, and a Social Robot in a Hospital Memory Clinic},
  author={Addlesee, Angus and Cherakara, Neeraj and Nelson, Nivan and Garc\'ia, Daniel Hern{\'a}ndez and Gunson, Nancie and Siei{\'n}ska, Weronika and Dondrup, Christian and Lemon, Oliver},
  booktitle={Proceedings of the 18th Conference of the European Chapter of the Association for Computational Linguistics (EACL)},
  year={2024},
  selected={true},
  award={true},
  award_name={EACL Best Demo Award},
  abstract={We present an LLM-based spoken dialogue system deployed in a hospital setting, embodied by the ARI social robot. The system enables patients and companions to have conversations together with multimodal input and output including speech, video, and gestures. It determines when to participate in conversation, generates human-like clarification requests when patients pause mid-utterance, answers in-domain questions grounded in provided knowledge, and appropriately responds to out-of-domain requests such as jokes and quizzes. The system's ability to handle unexpected patient utterances represents a significant advancement in real-world deployment of dialogue systems.}
}

@inproceedings{addlesee2024clarifying,
  title={Clarifying Completions: Evaluating How LLMs Respond to Incomplete Questions},
  author={Addlesee, Angus and Lemon, Oliver and Eshghi, Arash},
  booktitle={Proceedings of the Joint International Conference on Computational Linguistics, Language Resources and Evaluation (LREC-COLING)},
  year={2024},
  selected={true},
  abstract={Humans process language incrementally, which leads to conversational phenomena like incremental clarification requests (iCRs) when someone pauses mid-sentence. We created SLUICE-CR, a corpus containing 3,000 human-generated iCRs, to evaluate whether large language models can generate appropriate clarifying responses to incomplete questions. We find that the ability to produce contextually suitable iCRs only appears in larger language models and requires prompting with example iCRs from our corpus. The results suggest that autoregressive language models can understand and generate language incrementally, with implications for making conversational AI systems more accessible for users with memory impairment.}
}

@inproceedings{addlesee2024multiparty_llms,
  title={A Multi-party Conversational Social Robot Using LLMs},
  author={Addlesee, Angus and Cherakara, Neeraj and Nelson, Nivan and Garc\'ia, Daniel Hern{\'a}ndez and Gunson, Nancie and Siei{\'n}ska, Weronika and Romeo, Marta and Dondrup, Christian and Lemon, Oliver},
  booktitle={Companion of the 2024 ACM/IEEE International Conference on Human-Robot Interaction (HRI)},
  year={2024},
  abstract={We present an LLM-based spoken dialogue system for a social robot deployed in a hospital memory clinic. The system accepts speech and video inputs while generating speech and gestures, manages turn-taking in multi-party conversations, generates clarification requests when patients pause mid-utterance, and handles both in-domain clinical questions and out-of-domain social requests. We demonstrate coordination with clinicians and carers in real hospital settings.}
}

@article{payne2024self,
  title = {Self-ownership, not self-production, modulates bias and agency over a synthesised voice},
  journal = {Cognition},
  volume = {248},
  pages = {105804},
  year = {2024},
  issn = {0010-0277},
  doi = {https://doi.org/10.1016/j.cognition.2024.105804},
  url = {https://www.sciencedirect.com/science/article/pii/S0010027724000908},
  author = {Bryony Payne and Angus Addlesee and Verena Rieser and Carolyn McGettigan},
  abstract={Voices are fundamentally social stimuli, and their importance to the self may be underpinned by how far they can be used to express the self in communication contexts. We created an experimental setup using a two-player online game where participants communicated through text-to-speech technology, then measured participants' psychological identification with and perceived agency over the synthesized voices. Our key finding is that ownership of the voice matters more than whether participants actively produced or controlled its creation in determining their bias toward it and their sense of agency.}
}

@inproceedings{gunson2024holistic,
  title={A Holistic Evaluation Methodology for Multi-Party Spoken Conversational Agents},
  author={Gunson, Nancie and Addlesee, Angus and Garcia, Daniel Hern{\'a}ndez and Dondrup, Christian and Lemon, Oliver},
  booktitle={Proceedings of the 24th International Conference on Intelligent Virtual Agents (IVA)},
  year={2024},
  abstract={While research has advanced sub-tasks like speaker identification, there is a gap in fully autonomous multi-party applications users can directly interact with. We develop a multi-modal robot receptionist for hospital waiting rooms using Large Language Models and present an experimental methodology and design of task-based user experiments that captures both objective measures of multi-party dialogue performance (such as accurate tracking of user goals) and the users' subjective experience of multi-party embodied conversations, providing a holistic methodology for the future evaluation of multi-party spoken conversational agents.}
}

@inproceedings{addlesee2024grounding,
  title={Grounding LLMs to In-prompt Instructions: Reducing Hallucinations Caused by Static Pre-training Knowledge},
  author={Addlesee, Angus},
  booktitle={Proceedings of the 3rd workshop on Safety for Conversational AI (Safety4ConvAI)},
  year={2024},
  abstract={LLMs can hallucinate when domain-specific knowledge in prompts conflicts with their pre-training data. We curated a QA corpus with information unseen during training and tested various LLMs while manipulating prompt and knowledge formats. We find that a specific prompt format consistently improves the model's textual grounding to given knowledge, yielding accuracy improvements of up to 28\% across healthcare and finance domains with a 12\% mean improvement. We also identify that hierarchical and direct node-property graph structures can enhance interpretability and controllability, enabling safer LLM deployment in critical applications.}
}

@inproceedings{sieinska2024multi,
  title={A Multi-party Dialogue Dataset for Dialogue Goal Tracking in a Hospital Setting and How It Can Be Used in LLM Prompt Engineering Experiments},
  author={Siei{\'n}ska, Weronika and Addlesee, Angus and Garcia, Daniel Hern{\'a}ndez and Gunson, Nancie and Romeo, Marta and Dondrup, Christian and Lemon, Oliver},
  booktitle={Proceedings of the 28th Workshop on the Semantics and Pragmatics of Dialogue (SemDial)},
  year={2024},
  abstract={Releases a hospital dialogue dataset and demonstrates how it stress-tests LLM prompt engineering for goal tracking.}
}

@inproceedings{addlesee2023multiparty,
  title={Multi-party Goal Tracking with LLMs: Comparing Pre-training, Fine-tuning, and Prompt Engineering},
  author={Addlesee, Angus and Siei{\'n}ska, Weronika and Gunson, Nancie and Garcia, Daniel Hern{\'a}ndez and Dondrup, Christian and Lemon, Oliver},
  booktitle={Proceedings of the 24th Annual Meeting of the Special Interest Group on Discourse and Dialogue},
  year={2023},
  abstract={We recorded 29 interactions involving patients, companions, and a social robot in a hospital setting, then labeled them for goal-tracking and intent-slot tasks. We compared three approaches: fine-tuning T5, pre-training DialogLM with LED, and prompt engineering with GPT-3.5-turbo using minimal data. GPT-3.5-turbo significantly outperformed the others in a few-shot setting, with reasoning-style prompts achieving the best results at 62.32\% goal-tracking accuracy and 69.57\% intent-slot accuracy when trained on just 7\% of the corpus. Story-style prompts increased hallucinations, posing safety concerns in critical applications.}
}

