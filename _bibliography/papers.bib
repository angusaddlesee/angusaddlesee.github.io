  booktitle={Proceedings of the 10th Amazon Machine Learning Conference},
  year={2022},
  abstract={Analyses how assistants can infer intent from partial questions and proposes strategies to elicit the missing context.}
}

@inproceedings{ramil2021allergic,
  title={Am i allergic to this? assisting sight impaired people in the kitchen},
  author={Ramil Brick, Elisa and Caballero Alonso, Vanesa and O'Brien, Conor and Tong, Sheron and Tavernier, Emilie and Parekh, Amit and Addlesee, Angus and Lemon, Oliver},
  booktitle={Proceedings of the 2021 International Conference on Multimodal Interaction},
  pages={92--102},
  year={2021},
  abstract={Builds a multimodal assistant that checks ingredients and safety information to support visually impaired cooks.}
}

@inproceedings{baker2021spoon,
  title={The spoon is in the sink: Assisting visually impaired people in the kitchen},
  author={Baker, Katie and Parekh, Amit and Fabre, Adrien and Addlesee, Angus and Kruiper, Ruben and Lemon, Oliver},
  booktitle={Proceedings of the Reasoning and Interaction Conference (ReInAct 2021)},
  pages={32--39},
  year={2021},
  abstract={We present an extended Visual Question Answering system designed to help blind and partially sighted individuals navigate kitchens, built on three key design principles: privacy (as the camera may capture sensitive items), transparency for explaining system behaviour, and controllability for domain customisation. The enhanced system can address queries about quantity, positioning, and system confidence regarding 299 kitchen objects. Spatial relationship questions prove particularly valuable for visually impaired users, and the system delivers more practical responses than comparable end-to-end VQA technologies.}
}

@inproceedings{addlesee2021incremental,
  title={Incremental Graph-Based Semantics and Reasoning for Conversational AI},
  author={Addlesee, Angus and Eshghi, Arash},
  booktitle={Proceedings of the Reasoning and Interaction Conference (ReInAct 2021)},
  pages={1--7},
  year={2021},
  abstract={Next-generation conversational AI systems require incremental processing (handling language token-by-token), incremental reasoning (establishing meaning beyond literal utterances), and transparency and control (enabling designers to explain behaviour). We propose combining Dynamic Syntax, an incremental semantic grammar framework, with the Resource Description Framework (RDF) to create incremental semantic parsers that progressively output semantic RDF graphs as an utterance unfolds in real-time. This hybrid approach yields semantic infrastructure that can be used to build responsive, real-time, interpretable conversational AI customisable for specialised populations including people with dementia.}
}

@inproceedings{addlesee2020comprehensive,
  title={A comprehensive evaluation of incremental speech recognition and diarization for conversational AI},
  author={Addlesee, Angus and Yu, Yanchao and Eshghi, Arash},
  booktitle={Proceedings of the 28th International Conference on Computational Linguistics},
  pages={3492--3503},
  year={2020},
  abstract={We evaluate automatic speech recognition and speaker diarisation systems from major commercial providers for conversational AI applications, assessing how well they handle real-time incremental processing with challenges like speech disfluencies and overlapping dialogue. Microsoft offers the leading incremental ASR system which preserves disfluent materials, IBM excels in speaker diarisation and robustness to overlaps, and Google provides middle-ground performance. However, none of these systems are yet suitable to reliably handle natural spontaneous conversations in real-time, which is critical for dialogue systems handling multi-party interactions.}
}

@inproceedings{addlesee2020ethically,
  title={Ethically Collecting Multi-Modal Spontaneous Conversations with People that have Cognitive Impairments},
  author={Addlesee, Angus and Albert, Pierre},
  booktitle={LREC 2020 Workshop Language Resources and Evaluation Conference 11--16 May 2020},
  pages={15},
  year={2020},
  abstract={Recordings of multi-modal spontaneous conversations with vulnerable user groups are scarce, and such data collection presents ethical and legal complexities that many researchers lack experience navigating. We consulted with experts over a year-long period and created CUSCO, a secure system for capturing and sharing sensitive recordings. This work provides practical guidance to help researchers ethically collect conversational data from people with cognitive impairments while maintaining appropriate security standards for vulnerable populations.}
}

@inproceedings{addlesee2019current,
  title={Current Challenges in Spoken Dialogue Systems and Why They Are Critical for Those Living with Dementia},
  author={Addlesee, Angus and Eshghi, Arash and Konstas, Ioannis},
  booktitle={Dialogue for Good (DiGo)},
  year={2019},
  abstract={Current dialogue systems like Alexa are not yet naturally interactive: they are often turn-based, have naive end-of-turn detection, and overlook crucial conversational cues including backchannels, hesitation markers, filled pauses, gaze, and disfluencies. This limitation poses particular challenges for vulnerable populations, as dialogue system users in healthcare contexts are likely to be frail, older, distracted, or suffer from cognitive decline which impacts their ability to make effective use of current systems. We propose urgent research priorities including incremental speech recognition development and systematic analysis of conversation patterns potentially diagnostic of dementia.}
}
